{
  "name": "centaur-medical-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Centaur Medical — Medical Records Management System (frontend plugin)",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build:lib": "vue-cli-service build --target lib --name CentaurMedical src/index.ts",
    "build:example": "vue-cli-service build",
    "test:unit": "tsx --tsconfig tests/tsconfig.json tests/unit/run-unit.ts",
    "test:integration": "tsx --tsconfig tests/tsconfig.json tests/integration/run-integration.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "c8 --check-coverage --lines 50 --statements 50 --include \"src/utils/**\" --include \"src/stores/**\" --include \"src/services/**\" --exclude \"tests/**\" tsx --tsconfig tests/tsconfig.json tests/unit/run-unit.ts"
  },
  "main": "dist/CentaurMedical.common.js",
  "dependencies": {
    "axios": "^1.6.7",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/sinon": "^22.0.0",
    "@types/tape": "^5.8.1",
    "@vue/babel-plugin-jsx": "^1.2.2",
    "@vue/cli-plugin-babel": "~5.0.8",
    "@vue/cli-plugin-typescript": "~5.0.8",
    "@vue/cli-service": "~5.0.8",
    "@vue/test-utils": "^2.4.4",
    "c8": "^12.0.0",
    "jsdom": "^29.1.1",
    "sinon": "^22.1.0",
    "tape": "^5.10.2",
    "tsx": "^4.23.12",
    "typescript": "~4.9.5"
  }
}
