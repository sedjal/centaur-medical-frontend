{
  "name": "centaur-medical-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Centaur Medical — Medical Records Management System (frontend plugin)",
  "scripts": {
    "serve": "vue-cli-service serve example/main.ts",
    "build:lib": "vue-cli-service build --target lib --name CentaurMedical src/index.ts",
    "build:example": "vue-cli-service build example/main.ts",
    "test:unit": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "main": "dist/CentaurMedical.common.js",
  "dependencies": {
    "axios": "^1.6.7",
    "lucide-vue-next": "^0.344.0",
    "pinia": "^2.1.7",
