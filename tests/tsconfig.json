{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "vue",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitAny": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./jsdom.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../src/**/*.d.ts"
  ],
  "exclude": ["../node_modules", "../dist"]
}
