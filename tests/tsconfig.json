{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "vue",
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./jsdom.d.ts",
    "../src/**/*.ts",
    "../src/**/*.tsx"
  ]
}
